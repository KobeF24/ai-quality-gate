{
  "name": "ai-quality-gate",
  "version": "0.1.0",
  "private": true,
  "description": "Quality gate for an LLM feature: Playwright tests + Promptfoo evals + red teaming",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env app/server.ts",
    "test": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start:live": "MODE=live node --env-file-if-exists=.env app/server.ts",
    "eval": "promptfoo eval -c evals/promptfooconfig.yaml"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "promptfoo": "^0.126.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "yaml": "^2.9.1"
  }
}
